# Copy to .env for local runs. Do not commit real credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
OPS_INGEST_TOKEN=replace-with-at-least-24-random-characters
OPS_RELAY_URL=http://127.0.0.1:8080
OPS_BIND_HOST=0.0.0.0
OPS_PORT=8080
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RETRIES=5
LOG_LEVEL=INFO

# Windows production execution. Replace every placeholder in a local .env.
TRADING_ENABLED=false
REQUIRE_OPTIMIZED_CONFIG=false
REQUIRE_DEMO_ACCOUNT=true
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_POLL_INTERVAL_SECONDS=0.05
MT5_RECONNECT_DELAY_SECONDS=2
RISK_MAX_DAILY_LOSS_PCT=0.02
RISK_MAX_SPREAD_POINTS=
NEWS_CALENDAR_ENABLED=true
NEWS_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
NEWS_CALENDAR_REFRESH_SECONDS=900
NEWS_CALENDAR_MAX_AGE_SECONDS=7200
NEWS_BLACKOUT_MINUTES=30
